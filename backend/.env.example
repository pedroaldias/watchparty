# O servidor lê variáveis de ambiente. No Render, cadastre-as no painel.
# Localmente, exporte-as no terminal ou rode: node --env-file=.env server.js

# Porta (o Render define sozinho)
PORT=3001

# Use "production" no Render. Em produção, só aceita origens listadas em
# ALLOWED_ORIGINS (ou a própria origem do servidor).
NODE_ENV=development

# Frontend em outro domínio (ex.: Vercel). Separe vários por vírgula.
ALLOWED_ORIGINS=

# Credenciais da conta de serviço do Google. Use UMA das opções:
# 1) arquivo local (padrão: backend/credentials.json)
GOOGLE_CREDENTIALS_FILE=./credentials.json
# 2) JSON inteiro numa variável (recomendado no Render)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}

# Opcional: exige este código para CRIAR salas (evita estranhos usando seu servidor)
ACCESS_CODE=

# Opcional
MAX_ROOM_SIZE=8
MAX_ROOMS=100
MAX_STREAMS_PER_IP=8
